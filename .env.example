# --- Configurações do Servidor ---
PORT=3000
CORS_ORIGIN=http://localhost:5500

# --- OpenRouter (IA) ---
OPENROUTER_API_KEY=sua_chave_da_openrouter_aqui
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_REFERER=http://localhost
OPENROUTER_TITLE=Viva Rita de Cassia Validator

# --- AWS S3 (Infraestrutura Terraform) ---
S3_BUCKET_NAME=sanko-memorias-storage-prod
AWS_ACCESS_KEY_ID=sua_access_key_do_usuario_iam
AWS_SECRET_ACCESS_KEY=sua_secret_key_do_usuario_iam
AWS_REGION=us-east-1